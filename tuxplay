#!/usr/bin/env bash
# tuxplay - AirPlay 2 speakers as Linux audio outputs (talks to tuxplayd).
#
#   delay   how long after a sound is played it is heard: the anchor lead. A
#           change takes effect at once; what is playing pauses for a moment
#           and is anchored again.
#   sync    a correction against the picture. It only changes the latency
#           players are told, so they hold the picture back more or less; the
#           sound itself is not touched and nothing pauses.
#   idle    release the speakers after this many minutes without sound, so
#           they go dark and are free. Never, by default, as with a Mac.
set -euo pipefail

API=${TUXPLAY_API:-http://localhost:3689}

usage() {
  cat >&2 <<'EOF'
usage:
  tuxplay status            show what is set now
  tuxplay delay <ms>        set the delay (50-5000 ms), e.g. tuxplay delay 250
  tuxplay <ms>              the same
  tuxplay sync earlier <ms> sound arrives late (picture ahead): move it earlier
  tuxplay sync later <ms>   sound arrives early: move it later
  tuxplay sync reset        no correction
  tuxplay idle <minutes>    release the speakers after this long without sound
  tuxplay idle never        never release them (the default)

Nudge sync 20 ms at a time; below about 20 ms nobody can see the difference.
EOF
  exit 2
}

die() { echo "tuxplay: $*" >&2; exit 1; }

latency_get() {
  curl -s --max-time 4 "$API/api/latency" || die "tuxplayd is not answering on $API"
}

field() {  # $1 = json, $2 = key
  printf '%s' "$1" | python3 -c "import json,sys; print(json.load(sys.stdin)['$2'])"
}

latency_put() {  # $1 = json body
  local out
  out=$(curl -s --max-time 6 -X PUT -H 'Content-Type: application/json' -d "$1" "$API/api/latency") \
    || die "tuxplayd is not answering on $API"
  case "$out" in *'"result"'*) ;; *) die "tuxplayd refused it: $out" ;; esac
}

is_ms() { case "$1" in ''|*[!0-9]*) return 1 ;; esac; }

[ $# -ge 1 ] || usage

case "$1" in
  status)
    j=$(latency_get)
    printf 'delay you hear:        %s ms (anchor lead)\n' "$(field "$j" ms)"
    printf 'sync correction:       %+d ms\n' "$(field "$j" sync_ms)"
    printf 'advertised to clients: %s ms\n' "$(field "$j" advertised_ms)"
    m=$(field "$(curl -s --max-time 4 "$API/api/idle")" minutes)
    if [ "$m" -gt 0 ]; then
      printf 'release when idle:     after %s min without sound\n' "$m"
    else
      printf 'release when idle:     never\n'
    fi
    ;;

  idle)
    [ $# -eq 2 ] || usage
    case "$2" in
      off|never) m=0 ;;
      *) is_ms "$2" || usage; m=$2 ;;
    esac
    out=$(curl -s --max-time 6 -X PUT -H 'Content-Type: application/json' -d "{\"minutes\": $m}" "$API/api/idle") \
      || die "tuxplayd is not answering on $API"
    case "$out" in *'"result"'*) ;; *) die "tuxplayd refused it: $out" ;; esac
    if [ "$m" -gt 0 ]; then echo "releasing the speakers after $m min without sound"; else echo "never releasing the speakers"; fi
    ;;

  delay)
    [ $# -eq 2 ] && is_ms "$2" || usage
    latency_put "{\"ms\": $2}"
    echo "delay set to $2 ms"
    ;;

  sync)
    [ $# -ge 2 ] || usage
    cur=$(field "$(latency_get)" sync_ms)
    case "$2" in
      reset)   new=0 ;;
      earlier) [ $# -eq 3 ] && is_ms "$3" || usage; new=$(( cur - $3 )) ;;
      later)   [ $# -eq 3 ] && is_ms "$3" || usage; new=$(( cur + $3 )) ;;
      *)       usage ;;
    esac
    latency_put "{\"sync_ms\": $new}"
    printf 'sync correction %+d ms\n' "$new"
    ;;

  *)
    is_ms "$1" && [ $# -eq 1 ] || usage
    latency_put "{\"ms\": $1}"
    echo "delay set to $1 ms"
    ;;
esac
