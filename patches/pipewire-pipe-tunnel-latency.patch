+/* Let the DECLARED latency be changed on a live sink, with no module reload.
+ *
+ * pw_stream accepts only SPA_PARAM_Props from a remote set_param - every other
+ * param id returns -ENOTSUP, including ProcessLatency and Latency themselves -
+ * and the adapter forwards a Props pod down to the follower untouched. So Props
+ * is the only door into a running node, and SPA_PROP_latencyOffsetNsec is the
+ * closest-matching standard key.
+ *
+ * The value is read as the ABSOLUTE declared latency in nanoseconds, not as an
+ * offset added to tunnel.latency.msec. That keeps the runtime value and the
+ * configured one in the same units and the same meaning, so a caller that
+ * writes the config file and sets this leaves one state behind, not two that
+ * later have to be reconciled.
+ *
+ * Zero and negative values are ignored deliberately. A session manager that
+ * restores properties onto this node could otherwise push 0 and silently undo
+ * the configured latency; requiring a positive number means the only way to
+ * move it is to ask for a real one.
+ */
+static void stream_param_changed(void *d, uint32_t id, const struct spa_pod *param)
+{
+	struct impl *impl = d;
+	int64_t ns = 0;
+
+	if (id != SPA_PARAM_Props || param == NULL)
+		return;
+
+	if (spa_pod_parse_object(param, SPA_TYPE_OBJECT_Props, NULL,
+			SPA_PROP_latencyOffsetNsec, SPA_POD_OPT_Long(&ns)) < 0)
+		return;
+
+	if (ns <= 0 || (uint64_t)ns == impl->process_latency.ns)
+		return;
+
+	pw_log_info("latency set at runtime: ns=%"PRIi64" (was %"PRIi64")",
+			ns, (int64_t)impl->process_latency.ns);
+
+	impl->process_latency.ns = ns;
+	update_latency_params(impl);
+}
