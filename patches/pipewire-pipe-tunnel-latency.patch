+/* Push the configured downstream latency onto the live stream. Passing these
+ * to pw_stream_connect() is not enough: the adapter recomputes port latency
+ * during negotiation and zeroes them. module-raop-sink updates params after
+ * the stream exists, so do the same. */
+static void update_latency_params(struct impl *impl)
+{
+	uint8_t buffer[1024];
+	struct spa_pod_builder b;
+	const struct spa_pod *params[3];
+	struct spa_latency_info in_latency, out_latency;
+	uint32_t n_params = 0;
+
+	if (impl->stream == NULL || impl->process_latency.ns <= 0)
+		return;
+
+	spa_pod_builder_init(&b, buffer, sizeof(buffer));
+
+	in_latency = SPA_LATENCY_INFO(SPA_DIRECTION_INPUT);
+	spa_process_latency_info_add(&impl->process_latency, &in_latency);
+
+	out_latency = SPA_LATENCY_INFO(SPA_DIRECTION_OUTPUT,
+			.min_ns = impl->process_latency.ns,
+			.max_ns = impl->process_latency.ns);
+
+	params[n_params++] = spa_latency_build(&b, SPA_PARAM_Latency, &in_latency);
+	params[n_params++] = spa_latency_build(&b, SPA_PARAM_Latency, &out_latency);
+	params[n_params++] = spa_process_latency_build(&b,
+			SPA_PARAM_ProcessLatency, &impl->process_latency);
+
+	pw_log_info("updating latency params: ns=%"PRIi64, (int64_t)impl->process_latency.ns);
+	pw_stream_update_params(impl->stream, params, n_params);
+}
