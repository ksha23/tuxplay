+// Starts a selection restored from the settings file, once the devices it
+// names have finished arriving. Started as a group so SETPEERS is populated
+// for every member; re-armed while any selected device is still waiting for
+// the rest of its group, and dropped as soon as one start goes through (a
+// group start covers all its members) or the tries run out.
+static void
+selection_restore_cb(int fd, short event, void *arg)
+{
+  struct timeval tv = { SELECTION_RESTORE_INTERVAL, 0 };
+  struct output_device *device;
+  bool fast_phase = (selection_restore_fast_tries < SELECTION_RESTORE_FAST_TRIES);
+  bool started = false;
+  bool waiting = false;
+
+  for (device = outputs_list(); device; device = device->next)
+    {
+      if (!device->selected || device->session)
+	continue;
+
+      // A device whose group id has not been attached yet answers
+      // outputs_device_group_ready() exactly as a genuinely ungrouped one
+      // does, and acting on that answer starts a pair member on its own,
+      // without its partner in SETPEERS - and before its AirPlay 2 candidate
+      // exists, so on the wrong protocol too. While the fast phase is still
+      // running, count an unclassified device as waiting; by the time it ends
+      // a device that still has no group id really is a single speaker.
