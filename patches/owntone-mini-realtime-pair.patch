+/*
+ * PUT /api/player/pause
+ *
+ * Pauses without dropping the AirPlay sessions: playback_pause() flushes the
+ * outputs (FLUSHBUFFERED), which leaves each receiver CONNECTED with a pending
+ * anchor rather than tearing the session down. The receiver stops rendering our
+ * stream and is free for another sender, while the RTSP connection and its
+ * keep-alive stay up so resuming costs one SETRATEANCHORTIME instead of a full
+ * session setup. This is how an Apple sender can hold a persistent connection
+ * without monopolising the speakers.
+ */
+static int
+jsonapi_reply_player_pause(struct httpd_request *hreq)
+{
+  int ret;
+
+  ret = player_playback_pause();
+  if (ret < 0)
+    {
+      DPRINTF(E_LOG, L_WEB, "Error pausing playback.\n");
+      return HTTP_INTERNAL;
+    }
+
+  return HTTP_NOCONTENT;
+}
+
+/*
+ * PUT /api/player/idle  and  PUT /api/player/active
+ *
+ * Say whether media is playing, without changing whether audio is sent. A
+ * HomePod's white indicator follows the MediaRemote playback state rather than
+ * the samples, so a session held open for fast starts kept the speakers lit.
+ */
+static int
+jsonapi_reply_player_idle(struct httpd_request *hreq)
+{
+  if (player_set_idle_indicator(true) < 0)
+    return HTTP_INTERNAL;
+
+  return HTTP_NOCONTENT;
+}
+
+static int
+jsonapi_reply_player_active(struct httpd_request *hreq)
+{
+  if (player_set_idle_indicator(false) < 0)
+    return HTTP_INTERNAL;
+
+  return HTTP_NOCONTENT;
+}
+
+/*
+ * PUT /api/player/park  and  PUT /api/player/unpark
+ *
+ * EXPERIMENT (HomePod idle LED). Stop the receiver rendering without ending
+ * the session: SETRATEANCHORTIME rate=0 plus a local delivery gate. Unpark
+ * re-anchors at rate=1. See outputs_airplay_park() in outputs/airplay.c.
+ */
+static int
+jsonapi_reply_player_park(struct httpd_request *hreq)
+{
+  if (player_set_park(true) < 0)
+    return HTTP_INTERNAL;
+
+  return HTTP_NOCONTENT;
+}
+
+static int
+jsonapi_reply_player_unpark(struct httpd_request *hreq)
+{
+  if (player_set_park(false) < 0)
+    return HTTP_INTERNAL;
+
+  return HTTP_NOCONTENT;
+}
+
+/*
+ * GET /api/player/silence
+ *
+ * How long the pipe has been carrying digital silence, in milliseconds, or -1
+ * if it has never carried audio. Lets a supervisor tell whether anything is
+ * really playing - cork state does not, since a paused player commonly keeps
+ * its stream open and writes zeroes - without opening a capture stream on the
+ * sink's monitor, which makes the desktop flash its microphone indicator.
+ */
+static int
+jsonapi_reply_player_silence(struct httpd_request *hreq)
+{
+  json_object *jreply;
+
+  jreply = json_object_new_object();
+  json_object_object_add(jreply, "silent_msec", json_object_new_int(pipe_silent_msec()));
+
+  CHECK_ERRNO(L_WEB, evbuffer_add_printf(hreq->out_body, "%s", json_object_to_json_string(jreply)));
+
+  jparse_free(jreply);
+
+  return HTTP_OK;
+}
