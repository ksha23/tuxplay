+// Milliseconds since the pipe last carried audio, or -1 if it never has.
+int
+pipe_silent_msec(void)
+{
+  struct timespec now_ts;
+
+  if (pipe_last_audio.tv_sec == 0 && pipe_last_audio.tv_nsec == 0)
+    return -1;
+
+  clock_gettime(CLOCK_MONOTONIC, &now_ts);
+
+  return (int)((now_ts.tv_sec - pipe_last_audio.tv_sec) * 1000
+	       + (now_ts.tv_nsec - pipe_last_audio.tv_nsec) / 1000000);
