+static void
+sample_push(struct airptp_sample *buf, int *n, int max, int64_t local_ns, int64_t value_ns)
+{
+  if (*n == max)
+    {
+      memmove(buf, buf + 1, (max - 1) * sizeof(*buf));
+      (*n)--;
+    }
+
+  buf[*n].local_ns = local_ns;
+  buf[*n].value_ns = value_ns;
+  (*n)++;
