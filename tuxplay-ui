class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def _send(self, code, body, ctype):
        raw = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(raw)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(raw)

    def do_GET(self):
        if self.path == "/":
            self._send(200, PAGE, "text/html; charset=utf-8")
        elif self.path == "/api/state":
            self._send(200, json.dumps(state()), "application/json")
        else:
            self._send(404, "not found", "text/plain")

    def do_POST(self):
        n = int(self.headers.get("Content-Length") or 0)
        try:
            body = json.loads(self.rfile.read(n) or b"{}")
        except ValueError:
            body = {}

        if self.path == "/api/hold":
            run("/usr/local/bin/tuxplay hold %s" % ("on" if body.get("on") else "off"))
        elif self.path == "/api/master":
            if body.get("on"):
                run("systemctl --user start tuxplay-share")
            else:
                run("systemctl --user stop tuxplay-share")
                # Hand the speakers back rather than leaving them held by a
                # helper that is no longer running.
                rc, out, _ = run("curl -s --max-time 4 %s/api/outputs" % API)
                try:
                    for o in json.loads(out).get("outputs", []):
                        if "Stereo" in o.get("name", ""):
                            run("curl -s --max-time 6 -X PUT -H 'Content-Type: application/json'"
                                " -d '{\"selected\":false}' %s/api/outputs/%s" % (API, o["id"]))
                except Exception:
                    pass
        elif self.path == "/api/output":
            oid = str(body.get("id") or "")
            want = "true" if body.get("on") else "false"
            if oid.isdigit():
                run("curl -s --max-time 8 -X PUT -H 'Content-Type: application/json'"
                    " -d '{\"selected\":%s}' %s/api/outputs/%s" % (want, API, oid))
        elif self.path == "/api/delay":
            ms = int(body.get("ms") or 0)
            if 150 <= ms <= 3500:
                run("/usr/local/bin/tuxplay %d" % ms, timeout=90)
        elif self.path == "/api/sync":
            d = body.get("dir")
            if d == "reset":
                run("/usr/local/bin/tuxplay sync reset", timeout=90)
            elif d in ("earlier", "later"):
                run("/usr/local/bin/tuxplay sync %s %d" % (d, int(body.get("ms") or 20)),
                    timeout=90)
        else:
            self._send(404, "not found", "text/plain")
            return

        self._send(200, json.dumps({"ok": True}), "application/json")


if __name__ == "__main__":
    srv = ThreadingHTTPServer((BIND, PORT), Handler)
    sys.stderr.write("tuxplay-ui on http://%s:%d\n" % (BIND, PORT))
    srv.serve_forever()
