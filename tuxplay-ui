#!/usr/bin/env python3
"""tuxplay-ui - a small control panel for the HomePod pair output.

Serves a single page on the LAN so the pair can be controlled without
remembering command names, and from a phone or another machine rather than only
from a terminal on the box itself. Everything it does is also doable with
tuxplay and systemctl; this is the same controls with the reasoning
written next to them.

Python standard library only, deliberately: this runs on a machine whose audio
stack we have already made complicated enough, and it should not add another
thing that can fail to install.
"""

import html
import json
import os
import re
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

BIND = os.environ.get("TUXPLAY_UI_BIND", "0.0.0.0")
PORT = int(os.environ.get("TUXPLAY_UI_PORT", "8730"))
API = os.environ.get("TUXPLAY_API", "http://localhost:3689")
HOLD_CONF = os.path.expanduser("~/.config/tuxplay-hold.conf")
# The AirPlay control connection owntone holds to each connected speaker.
RTSP_PORT = int(os.environ.get("TUXPLAY_RTSP_PORT", "7000"))


def run(cmd, timeout=25):
    try:
        p = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout.strip(), p.stderr.strip()
    except subprocess.TimeoutExpired:
        return 1, "", "timed out"


def state():
    # Only established connections: sockets still closing count as nothing.
    # (Not filtered by process: owntone's socket owners are hidden from ss.)
    rc, out, _ = run("ss -tnH state established '( dport = :%d )' 2>/dev/null | wc -l"
                     % RTSP_PORT)
    sessions = int(out) if out.isdigit() else 0

    rc, out, _ = run("/usr/local/bin/tuxplay status 2>/dev/null")
    delay = sync = advertised = None
    for line in out.splitlines():
        m = re.search(r"delay you hear:\s+(\d+)", line)
        if m:
            delay = int(m.group(1))
        m = re.search(r"sync correction:\s+([+-]?\d+)", line)
        if m:
            sync = int(m.group(1))
        m = re.search(r"advertised to clients:\s+(\d+)", line)
        if m:
            advertised = int(m.group(1))

    hold = False
    try:
        with open(HOLD_CONF) as fh:
            hold = "HOLD=1" in fh.read()
    except OSError:
        pass

    _, watcher, _ = run("systemctl --user is-active tuxplay-share")
    _, server, _ = run("systemctl is-active owntone-mini")

    outputs, pair = [], None
    rc, out, _ = run("curl -s --max-time 4 %s/api/outputs" % API)
    try:
        for o in json.loads(out).get("outputs", []):
            entry = {"id": str(o["id"]), "name": o.get("name", "?"),
                     "type": o.get("type", ""), "selected": bool(o.get("selected")),
                     "volume": o.get("volume")}
            outputs.append(entry)
            # The collapsed stereo pair is still called out separately, because
            # it is the one output whose members must be driven together.
            if "Stereo" in entry["name"]:
                pair = entry
    except Exception:
        pass
    chosen = [o for o in outputs if o["selected"]]

    silent = None
    rc, out, _ = run("curl -s --max-time 4 %s/api/player/silence" % API)
    try:
        silent = json.loads(out).get("silent_msec")
    except Exception:
        pass

    names = ", ".join(o["name"] for o in chosen) or "nothing"
    if watcher != "active":
        status, detail = "off", "The helper is stopped, so nothing is managing the outputs."
    elif not outputs:
        status, detail = "missing", "No AirPlay devices have been discovered yet."
    elif not chosen:
        status, detail = "released", "No output selected. Pick one below."
    elif sessions > 0 and silent is not None and 0 <= silent < 1500:
        status, detail = "playing", "Audio is going to %s." % names
    elif sessions > 0:
        status, detail = "ready", "Connected to %s and idle. Playback starts immediately." % names
    else:
        status, detail = "released", "%s selected, not connected yet." % names

    return {"sessions": sessions, "delay": delay, "sync": sync, "advertised": advertised,
            "hold": hold, "watcher": watcher, "server": server, "pair": pair,
            "outputs": outputs, "silent_msec": silent, "status": status, "detail": detail}


